# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# Le fichier ".env" ne doit jamais être partagé ni mis sur GitHub.

# --- Base de données MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=industriel_minier

# --- Envoi d'email (pour le code de vérification) ---
# Exemple avec Gmail : active la validation en 2 étapes sur le compte,
# puis crée un "mot de passe d'application" (App Password) sur
# https://myaccount.google.com/apppasswords et utilise-le ici,
# jamais ton vrai mot de passe Gmail.
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=587
SMTP_UTILISATEUR=ton.email@gmail.com
SMTP_MOT_DE_PASSE=ton_mot_de_passe_application

# Si les variables SMTP ci-dessus ne sont pas renseignées,
# le serveur n'enverra pas de vrai email : il affichera le code
# de vérification dans la console du terminal, pour que tu puisses
# quand même tester l'application.
