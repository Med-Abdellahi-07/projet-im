# Copy this file to ".env" and fill in your real values.
# ".env" is ignored by git: never commit it, never share it.

# --- Runtime ---
# development: verification codes are printed in the console and returned by the API
# production : never exposes verification codes, requires JWT_SECRET
NODE_ENV=development
PORT=3000

# Secret used to sign session cookies (at least 32 random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime in hours
SESSION_HOURS=8

# Origins (comma separated) allowed to call the API from another site.
# Leave empty: the app serves its own frontend, so same-origin is enough.
ALLOWED_ORIGIN=

# --- MySQL database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=industriel_minier
# true for managed services that require TLS (TiDB Cloud, Aiven, ...)
DB_SSL=false

# --- E-mail (verification codes). Sign-up works only when this is set. ---
# Gmail example: enable 2-step verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and use it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Public demo (optional) ---
# DEMO_MODE=true turns the whole database into a demo database: on start and
# every DEMO_RESET_HOURS hours all data is replaced by fictional data and the
# only account is the verified demo account. NEVER use it with real data.
DEMO_MODE=false
DEMO_EMAIL=demo@projet-im.app
DEMO_PASSWORD=
DEMO_RESET_HOURS=24
